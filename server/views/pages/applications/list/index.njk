{%- from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs -%}
{% extends "../../../partials/layout.njk" %}
{% from "../../../partials/breadcrumb.njk" import breadcrumb %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}

{% set pageTitle = "Manage apps" %}
{% set mainClasses = "govuk-body" %}

{% block beforeContent %}
  <div class="govuk-width-container govuk-!-margin-top-6">

    {{ govukBreadcrumbs({
      classes: "govuk-!-margin-bottom-2",
      items: [
        {
          text: "Home",
          href: launchpadHome
        },
        {
          text: "Manage apps",
          href: "/"
        }
      ]
    }) }}
  </div>
{% endblock %}
{% block content %}
  <div class="govuk-width-container govuk-!-padding-bottom-5">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ firstName }}'s apps</h1>

    <p class="govuk-body-l">Apps you have already sent.</p>

    {{ mojSubNavigation({
      label: "Apps",
      items: [
        {
          text: "Open",
          href: "/applications?tab=open",
          active: activeTab == "open"
        },
        {
          text: "Closed",
          href: "/applications?tab=closed",
          active: activeTab == "closed"
        }
      ]
    }) }}

    {% if apps and apps.length %}
      {% include "./partials/results.njk" %}
    {% else %}
      <p class="govuk-body">You have not not sent any apps.</p>

      {{ govukButton({
        text: "Send a new app",
        href: '/log/group'
      }) }}
    {% endif %}
  </div>
{% endblock %}
