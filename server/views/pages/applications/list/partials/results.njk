{% from "../../../../components/pagination/macro.njk" import pagination as paginationMacro %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% macro results(apps, paginationData, tab, hash, qa) %}
<div class="app-results-table">
  <h2 class="govuk-heading-m">{% if tab == "closed" %}Closed apps{% else %}Open apps{% endif %}</h2>
  {{ govukTable({
    head: [
      { text: "App" },
      {
        text: "Last updated" if tab == "closed" else "Date sent"
      },
      { text: "Status" }
    ],
    rows: apps,
    classes: "govuk-table",
    attributes: { "data-qa": qa }
  }) }}

  {{ paginationMacro(paginationData, { tab: tab }, hash) }}

  <p class="govuk-body">Showing {{ paginationData.min }} to {{ paginationData.max }} of {{ paginationData.totalCount }} total results</p>
</div>
{% endmacro %}
